# Copy to .env (git-ignored): cp .env.example .env
# Docker Compose reads .env from the repository root automatically.

# Linux only: run Airflow as your own user so it can write data/, models/ and metrics/ in this checkout.
# Set it to the output of `id -u` (typically 1000). The fallback, 50000, cannot write there.
AIRFLOW_UID=1000

# Uncomment to make a plain `docker compose up` start Airflow as well as the API.
# Leave it commented for API only (the Airflow image is over 2 GB).
# COMPOSE_PROFILES=airflow
